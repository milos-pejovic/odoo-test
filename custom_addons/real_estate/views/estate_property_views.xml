
<odoo>
    <!-- Form view-->
    <record id="real_estate_property_form_view_form" model="ir.ui.view">
        <field name="name">real_estate.property.view.form</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <button name="action_cancel" type="object" string="Cancel" class="btn btn-primary" />
                        <button name="action_sold" type="object" string="Sold" class="btn btn-primary" />
                    </group>
                    
                    <group>
                        <field name="status" string="" widget="statusbar" status_visible="active,sold" />
                    </group>
                </group>
                
                <sheet>
                    <group>
                        <h1>
                            <field name="name" placeholder="Enter property name"/>
                        </h1>
                    </group>

                    <group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" />
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="status" readonly="1"/>
                            <field name="property_type_id" />
                            <field name="postcode" placeholder="Enter postcode" />
                            <field name="date_availability" />
                        </group>
                        
                        <group>
                            <field name="expected_price" readonly="status == 'sold'"/>
                            <field name="best_offer"/>
                            <field name="selling_price" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <notebook class="o_notebook_bordered">
                            <page string="Description">
                                <group>
                                    <field name="bedrooms" />
                                    <field name="living_area" string="Living area (sqm)" />
                                    <field name="facades" />
                                    <field name="garage" />
                                    <field name="garden" />
                                    <field name="garden_area" string="Garden area (sqm)" options="{'readonly':[('garden', '=', False)]}" />
                                    <field name="garden_orientation" />
                                    <field name="total_area" string="Total area (sqm)" />
                                </group>
                            </page>

                            <page string="Computed dates (Temporary)">
                                <group>
                                    <field name="validity" />
                                    <field name="date_deadline" />
                                </group>
                            </page>

                            <page string="Offers">
                                <field name="offer_ids">
                                    <list editable="bottom" decoration-success="status == 'accepted'" decoration-danger="status == 'refused'">
                                        <field name="partner_id"/>
                                        <field name="price" />
                                        <button icon="fa-check" invisible="status in ['accepted', 'refused']" title="Accept offer" type="object" name="action_accept" />
                                        <button icon="fa-times" invisible="status in ['accepted', 'refused']" title="Refuse offer" type="object" name="action_refuse" /> 
                                        <field name="status" />
                                    </list>
                                </field>
                            </page>

                            <page string="Other Info">
                                <group>
                                    <field name="seller_id" />
                                    <field name="buyer_id" readonly="1" />
                                </group>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="real_estate_property_view_list" model="ir.ui.view">
        <field name="name">real_estate.property.view.list</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc, name">
                <field name="name" class="oe_inline o_list_char_width"/>
                <!-- <field name="status"/> -->
                <!-- <field name="create_date" /> -->
                <field name="number_of_offers" string="Offers" class="oe_number o_list_number_width"/>
                <field name="number_of_non_refused_offers" class="oe_number o_list_number_width"/>
                <field name="tag_ids" widget="many2many_tags" optional="True" class="o_list_many2one_width"/>
                <field name="date_availability"/>
                <field name="expected_price" />
                <field name="selling_price" readonly="1"/>
                <field name="property_type_id"/>
            </list>
        </field>
    </record>

    <!-- List view that inherits -->
    <record id="real_estate_property_view_list_inherit_1" model="ir.ui.view">
        <field name="name">real_estate.property.view.list.inherit</field>
        <field name="model">real_estate.property</field>
        <field name="inherit_id" ref="real_estate_property_view_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="status" />
            </xpath>
        </field>
    </record>

