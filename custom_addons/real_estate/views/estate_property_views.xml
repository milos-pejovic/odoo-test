    <!-- Search view -->
    <record id="real_estate_proeprty_search_view_search" model="ir.ui.view">
        <field name="name">real_estate.property.view.search</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="id" />
                <field name="name" filter_domain="[('name', 'ilike', self)]"/>
                <field name="postcode" filter_domain="[('postcode', 'ilike', self)]" />
                <field name="status" />
                <field name="expected_price" />
                <field name="bedrooms" />
                <field name="facades" />
                <separator>
                    <group string="Filter">
                        <filter string="Available" name="available" domain="[('status', '!=', 'sold')]" />
                        <!-- ##TODO: finish -->
                        
                        <!-- Make a non-refused offers present fitler -->
                        <!-- <filter string="Offer Received" name="filter_offer_received" domain="[]" /> -->
                    </group>
                    <group>
                        <filter string="Cottages" name="filter_cottages" domain="[('property_type_id.name', '=', 'Cottage')]" />
                    </group>
                    <group string="Other Filters">
                        <filter string="Non refused offers" name="filter_non_refused_proeprties" domain="[('number_of_non_refused_offers', '>', '0')]" />
                    </group>
                </separator>
                <separator>
                    <filter string="Houses" name="filter_houses" domain="[('property_type_id.name', '=', 'House')]" />
                </separator>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Real Estate</field>
        <field name="res_model">real_estate.property</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="view_id" ref="real_estate_property_view_list"/>  -->
        <field name="context">{"search_default_available" : 1}</field>
    </record>
</odoo>
