
<odoo>
    <!-- Form view-->
    <record id="real_estate_buyer_form_view_form" model="ir.ui.view">
        <field name="name">real_estate.buyer.view.form</field>
        <field name="model">real_estate.buyer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="email" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="real_estate_buyer_list_view_list" model="ir.ui.view">
        <field name="name">real_estate.buyer.view.list</field>
        <field name="model">real_estate.buyer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" width="150" />
                <field name="email" width="150" />
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="estate_buyer_action" model="ir.actions.act_window">
        <field name="name">Buyers</field>
        <field name="res_model">real_estate.buyer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
