<odoo>
    <!-- Form view-->
    <record id="real_estate_sellerview_form" model="ir.ui.view">
        <field name="name">real_estate.seller.view.form</field>
        <field name="model">real_estate.seller</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="email" />
                    </group>

                    <group>
                        <notebook class="o_notebook_bordered">
                            <page string="Properties">
                                <field name="property_ids">
                                    <list default_order="name">
                                        <field name="name" width="150" />
                                        <field name="status" width="100" />
                                        <field name="expected_price" width="150"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="real_estate_seller_list_view_list" model="ir.ui.view">
        <field name="name">real_estate.seller.view.list</field>
        <field name="model">real_estate.seller</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" width="150" />
                <field name="email" width="150" />
                <field string="Properties" name="properties_number" width="150" />
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="estate_seller_action" model="ir.actions.act_window">
        <field name="name">Sellers</field>
        <field name="res_model">real_estate.seller</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
