
<odoo>
    <!-- Form view-->
    <record id="real_estate_partner_form_view_form" model="ir.ui.view">
        <field name="name">real_estate.partner.view.form</field>
        <field name="model">real_estate.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="real_estate_partner_list_view_list" model="ir.ui.view">
        <field name="name">real_estate.partner.view.list</field>
        <field name="model">real_estate.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>

        </field>
    </record>

    <!-- Action -->
    <record id="estate_partner_action" model="ir.actions.act_window">
        <field name="name">Partners</field>
        <field name="res_model">real_estate.partner</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
