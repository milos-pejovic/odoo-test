
<odoo>
    <!-- Form view-->
    <record id="real_estate_offer_form_view_form" model="ir.ui.view">
        <field name="name">real_estate.offer.view.form</field>
        <field name="model">real_estate.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <h1>
                            <field name="buyer_id" />
                        </h1>
                    </group>

                    <group>
                        <field name="property_id" />
                        <field name="price"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="real_estate_offer_list_view_form" model="ir.ui.view">
        <field name="name">real_estate.offer.view.list</field>
        <field name="model">real_estate.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="buyer_id" />
                <field name="property_id" />
                <field name="price"/>
                <field name="status"/>
            </list>

        </field>
    </record>

    <!-- Action -->
    <record id="estate_offer_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">real_estate.offer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
