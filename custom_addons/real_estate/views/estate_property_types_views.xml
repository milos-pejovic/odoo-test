<odoo>
    <!-- Form view-->
    <record id="real_estate_property_type_form_view" model="ir.ui.view">
        <field name="name">real_estate.property_type.view.form</field>
        <field name="model">real_estate.property_type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <h1><field name="name" /></h1>
                    </group>

                    <group>
                        <notebook class="o_notebook_bordered">
                            <page string="Properties">
                                <field name="property_ids">
                                    <list default_order="name">
                                        <field name="name" />
                                        <field name="expected_price" />
                                        <field name="status" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="real_estate_property_type_list_view" model="ir.ui.view">
        <field name="name">real_estate.property_type.view.list</field>
        <field name="model">real_estate.property_type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="estate_property_type_action" model="ir.actions.act_window">
        <field name="name">Real Estate Types</field>
        <field name="res_model">real_estate.property_type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
