<odoo>
    <!-- Views -->
    <record id="view_property_sales_report_list" model="ir.ui.view">
        <field name="name">real_estate.property_sales_report.list</field>
        <field name="model">real_estate.property_sales_report</field>
        <field name="arch" type="xml">
            <list string="Property Sales Report">
                <field name="seller_id"/>
                <field name="property_count"/>
                <field name="total_value"/>
                <field name="average_selling_price" />
                <field name="sold_properties" />
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_property_sales_report" model="ir.actions.act_window">
        <field name="name">Property Sales Report</field>
        <field name="res_model">real_estate.property_sales_report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_property_sales_report_list"/>
        <field name="target">current</field>
    </record>
</odoo>
