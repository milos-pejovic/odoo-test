
<odoo>
    <!-- Form view-->
    <record id="fair_material_focus_material_view_form" model="ir.ui.view">
        <field name="name">fair_material.focus_material.view.form</field>
        <field name="model">fair_material.focus_material</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <h1>
                            <field name="name" />
                        </h1>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="fair_material_focus_material_view_list" model="ir.ui.view">
        <field name="name">fair_material.focus_material.view.list</field>
        <field name="model">fair_material.focus_material</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>

        </field>
    </record>

    <!-- Action -->
    <record id="focus_material_action" model="ir.actions.act_window">
        <field name="name">Focus materials</field>
        <field name="res_model">fair_material.focus_material</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
