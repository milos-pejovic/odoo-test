<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tin Attribute & Values -->
        <record id="attr_tin_origin" model="product.attribute">
            <field name="name">Tin Origin</field>
            <field name="create_variant">always</field>
        </record>

        <record id="val_tin_fairtrade" model="product.attribute.value">
            <field name="name">Fairtrade</field>
            <field name="attribute_id" ref="attr_tin_origin"/>
        </record>

        <record id="val_tin_non_fair" model="product.attribute.value">
            <field name="name">Non-Fair</field>
            <field name="attribute_id" ref="attr_tin_origin"/>
        </record>

        <!-- Tin Product Template -->
        <record id="product_template_tin" model="product.template">
            <field name="name">Tin</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="category_focus_materials"/>
            <field name="tracking">lot</field>
            <field name="sale_line_warn">no-message</field>
            <field name="purchase_line_warn">no-message</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="service_tracking">no</field>
            <field name="base_unit_count">0</field>

            <field name="attribute_line_ids" eval="[(0, 0, {
                'attribute_id': ref('attr_tin_origin'),
                'value_ids': [(6, 0, [ref('val_tin_fairtrade'), ref('val_tin_non_fair')])]
            })]"/>
        </record>
    </data>
</odoo>
