<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Product category -->
    <record id="category_focus_materials"
            model="product.category"
            forcecreate="True">
        <field name="name">Focus Materials</field>
    </record>

    <!-- ============================ -->
    <!--  PRODUCT ATTRIBUTE & VALUES  -->
    <!-- ============================ -->

    <!-- Attribute -->
    <record id="attr_material_origin"
            model="product.attribute"
            forcecreate="True">
        <field name="name">Material Origin</field>
        <field name="create_variant">always</field>
    </record>

    <!-- Values -->
    <record id="val_fairtrade"
            model="product.attribute.value"
            forcecreate="True">
        <field name="name">Fairtrade</field>
        <field name="attribute_id" ref="attr_material_origin"/>
    </record>

    <record id="val_non_fair"
            model="product.attribute.value"
            forcecreate="True">
        <field name="name">Non-Fair</field>
        <field name="attribute_id" ref="attr_material_origin"/>
    </record>

    <!-- ============================ -->
    <!--  PRODUCT TEMPLATE (GOLD)     -->
    <!-- ============================ -->

    <record id="product_template_gold"
            model="product.template"
            forcecreate="True">
        <field name="name">Gold</field>
        <field name="type">consu</field>
        <field name="categ_id" ref="category_focus_materials"/>
        <field name="tracking">lot</field>

        <!-- Required because not-null -->
        <field name="sale_line_warn">no-message</field>
        <field name="purchase_line_warn">no-message</field>

        <!-- Mandatory UoM -->
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="uom_po_id" ref="uom.product_uom_unit"/>

        <!-- Template fields -->
        <field name="service_tracking">no</field>
        <field name="base_unit_count">0</field>

        <!-- Attribute lines -->
        <field name="attribute_line_ids" eval="[(0, 0, {
            'attribute_id': ref('attr_material_origin'),
            'value_ids': [(6, 0, [ref('val_fairtrade'), ref('val_non_fair')])]
        })]"/>
    </record>

    <record id="product_template_tin"
        model="product.template"
        forcecreate="True">
        <field name="name">Tin</field>
        <field name="type">consu</field>
        <field name="categ_id" ref="category_focus_materials"/>
        <field name="tracking">lot</field>

        <!-- Required because not-null -->
        <field name="sale_line_warn">no-message</field>
        <field name="purchase_line_warn">no-message</field>

        <!-- Mandatory UoM -->
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="uom_po_id" ref="uom.product_uom_unit"/>

        <!-- Template fields -->
        <field name="service_tracking">no</field>
        <field name="base_unit_count">0</field>

        <!-- Attribute lines -->
        <field name="attribute_line_ids" eval="[(0, 0, {
            'attribute_id': ref('attr_material_origin'),
            'value_ids': [(6, 0, [ref('val_fairtrade'), ref('val_non_fair')])]
        })]"/>
    </record>


</odoo>
