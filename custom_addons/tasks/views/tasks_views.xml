
<odoo>
    <!-- Form view -->
    <record id="tasks_task_view_form" model="ir.ui.view">
        <field name="name">tasks.task.view.form</field>
        <field name="model">tasks.task</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="status" string="" widget="statusbar" status_visible="groomed, in_progress, testing, on_hold, done" />
                    </group>
                </group>
                
                <sheet>
                    <group>
                        <field name="title"></field>
                        <field name="priority"></field>
                        <field name="status"></field>
                        <field name="type"></field>
                        <field name="description" widget="text"></field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="tasks_task_view_list" model="ir.ui.view">
        <field name="name">tasks.task.view.list</field>
        <field name="model">tasks.task</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="title" width="200" />
                <field name="status" width="100" 
                widget="badge"
                options="{
                    'groomed': 'muted',
                    'in_progress': 'badge-success',
                    'testing': 'warning',
                    'on_hold': 'danger',
                    'done': 'primary'
                }"/>
                <field name="type" width="100" />
                <field name="description" width="500" />
                <field name="priority" width="150" />
            </list>
        </field>
    </record>


