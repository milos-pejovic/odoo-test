    <record id="tasks_task_view_kanban" model="ir.ui.view">
        <field name="name">tasks.task.view.kanban</field>
        <field name="model">tasks.task</field>
        <field name="arch" type="xml">

            <kanban string="Tasks Kanban"
                default_group_by="status"
                default_order="priority"
                records_draggable="1"
                group_expand="True">

            <!-- Optional progressbar showing status -->
            <progressbar 
                field="status"
                colors='{"1_groomed" : "info", "2_in_progress": "success", "3_testing": "warning", "4_on_hold" : "danger" , "5_done": "primary"}' />

            <!-- Fields shown on card -->
            <field name="status"/>
            <field name="priority"/>
            <field name="title"/>

            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_card">
                        <div class="mt-1">
                            <h3><field name="title"/></h3>
                        </div>
                        <div class="mt-1">
                            <span class="fw-bold">Priority: </span>
                            <field name="priority"/>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>


        </field>
    </record>


    <!-- Action -->
    <record id="tasks_action" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">tasks.task</field>
        <field name="view_mode">kanban,list,form</field>
        <!-- <field name="view_id" ref="real_estate_property_view_list"/>  -->
        <!-- <field name="context">{"search_default_available" : 1}</field> -->
    </record>
</odoo>
